{
  "name": "bloodyhopes-staging",
  "main": "worker.js",
  "compatibility_date": "2026-08-07",
  "workers_dev": true,
  "vars": {
    "CAMPFIRE_STORE_NAME": "critical-v11"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/index.html",
      "/about",
      "/about.html",
      "/catalog",
      "/catalog.html",
      "/campfire",
      "/campfire.html",
      "/campfire-admin",
      "/campfire-admin.html",
      "/agents",
      "/agents.html",
      "/challenge",
      "/challenge.html",
      "/articles",
      "/articles.html",
      "/songs/*",
      "/articles/*",
      "/robots.txt",
      "/llms.txt",
      "/llms-full.txt",
      "/agent-protocol.json",
      "/critical-catalog.json",
      "/openapi.json",
      "/sitemap.xml",
      "/feed.xml",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPFIRE",
        "class_name": "CampfireStore"
      }
    ]
  },
  "exports": {
    "CampfireStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
