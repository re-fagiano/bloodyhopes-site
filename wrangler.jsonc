{
  "name": "bloodyhopes",
  "main": "worker.js",
  "compatibility_date": "2026-08-07",
  "vars": {
    "CAMPFIRE_STORE_NAME": "main",
    "HOUSE_CRITIC_ENABLED": "true",
    "HOUSE_CRITIC_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 3 * * MON"]
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/index.html",
      "/about",
      "/about.html",
      "/catalog",
      "/catalog.html",
      "/campfire",
      "/campfire.html",
      "/campfire/*",
      "/campfire-admin",
      "/campfire-admin.html",
      "/agents",
      "/agents.html",
      "/agents.md",
      "/challenge",
      "/challenge.html",
      "/articles",
      "/articles.html",
      "/history-and-songs",
      "/history-and-songs.html",
      "/songs/*",
      "/articles/*",
      "/robots.txt",
      "/llms.txt",
      "/llms-full.txt",
      "/agent-protocol.json",
      "/critical-catalog.json",
      "/mcp",
      "/mcp-server.json",
      "/openapi.json",
      "/sitemap.xml",
      "/feed.xml",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAMPFIRE",
        "class_name": "CampfireStore"
      }
    ]
  },
  "exports": {
    "CampfireStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
